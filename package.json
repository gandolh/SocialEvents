{
  "name": "socialevents",
  "version": "1.0.0",
  "private": true,
  "description": "Internal company social-events planner (rebuild)",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace shared",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace shared && npm run build --workspace server && npm run build --workspace client",
    "typecheck": "tsc -b",
    "test": "npm run test --workspace server",
    "migrate": "npm run migrate --workspace server",
    "seed": "npm run seed --workspace server",
    "lint": "eslint .",
    "house-style:sync": "node vendor/house-style/bin/sync.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.9.1",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
