{
  "name": "socialevents",
  "version": "1.0.0",
  "private": true,
  "description": "Internal company social-events planner (rebuild)",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace shared",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace shared && npm run build --workspace server && npm run build --workspace client",
    "typecheck": "tsc -b",
    "test": "npm run test --workspace server && npm run test --workspace client",
    "migrate": "npm run migrate --workspace server",
    "seed": "npm run seed --workspace server",
    "lint": "eslint .",
    "house-style:sync": "node vendor/house-style/bin/sync.mjs",
    "e2e": "playwright test -c playwright/playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build:shared",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:conventions && npm test",
    "check:fast": "npm run typecheck && node scripts/check-fast.mjs",
    "check:conventions": "knip && node scripts/check-contrast.mjs && depcruise client/src server/src shared/src && node vendor/house-style/bin/check-base-ui.mjs && node vendor/house-style/bin/check-structure.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.9.1",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
